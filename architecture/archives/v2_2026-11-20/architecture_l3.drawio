        <mxCell id="b-1" value="Architecture de niveau 3 – VRF, routage, NAT, IPv4 et IPv6 · version 2 (après audit)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#101217;fontStyle=1;" vertex="1" parent="1">
